# ============================================================================
# CivicPulse AI - Backend Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AWS Infrastructure (DynamoDB & S3)
# ----------------------------------------------------------------------------
# In AWS production (EC2 IAM Instance Profile, ECS Task Role, or App Runner),
# leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty to let Boto3 automatically
# discover credentials via IAM Roles (IMDSv2 / ECS Task Credentials).
# For local development only, you can provide explicit access keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=CivicPulseTable
S3_BUCKET=civicpulse-evidence-store

# ----------------------------------------------------------------------------
# 2. AI Inference Engine (Groq High-Speed Vision & Reasoning)
# ----------------------------------------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------------------------
# 3. Autonomous Browser Agent & Municipal Portal Configuration
# ----------------------------------------------------------------------------
# Mode: "mock" (uses built-in mock PMC portal) or "live" (navigates real ULB websites)
PORTAL_MODE=mock
DEFAULT_PORTAL_URL=https://complaint.pmc.gov.in/
MOCK_PORTAL_URL=http://localhost:8000/mock-pmc-portal

# Headless Browser: MUST be true in production/Docker Linux without X11
HEADLESS_BROWSER=true

# ----------------------------------------------------------------------------
# 4. Networking & CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" for open access
CORS_ORIGINS=*
PORT=8000
